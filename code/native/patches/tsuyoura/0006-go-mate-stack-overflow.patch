+    //     kMaxDfpnPly 手までに抑える(それより深い手順は不詰扱い。8MB / 17KB ≒ 490 段に対して余裕を持たせる)。
+    constexpr int kMaxDfpnPly = 300;
+    dfpn.set_max_game_ply(pos.game_ply() + kMaxDfpnPly);
 
     std::atomic<Move> result(Move::resign());
-    std::thread        search_thread([&]() { result = dfpn.mate_dfpn(pos, (u32) nodes_limit); });
+    NativeThread       search_thread([&]() { result = dfpn.mate_dfpn(pos, (u32) nodes_limit); });
 
